# Immich Swipe - Environment Configuration
# Copy this file to .env and fill in your values.
# All values are baked into the bundle at build time. Anyone with access to
# the deployed app can read them — only deploy on a private network / Tailscale.

# Your Immich server URL.
# Two common shapes:
#   1) Same-origin proxy (recommended): point at this app's origin + /immich-api,
#      e.g. https://swipe.your-host.example/immich-api
#      The bundled nginx forwards /immich-api/* to the Immich server given by
#      X-Target-Host (sent by the client per request).
#   2) Direct CORS: point straight at Immich, e.g. https://immich.example.com
#      In this mode you must configure CORS on the Immich reverse proxy.
VITE_SERVER_URL=https://immich.example.com

# User 1
VITE_USER_1_NAME=Kevin
VITE_USER_1_API_KEY=your-immich-api-key-here

# User 2 (optional)
# VITE_USER_2_NAME=Partner
# VITE_USER_2_API_KEY=another-immich-api-key

# Add more users as needed (VITE_USER_3_*, VITE_USER_4_*, VITE_USER_5_*).
# Slots above 5 require widening Dockerfile + docker-compose.yml + vite-env.d.ts.
